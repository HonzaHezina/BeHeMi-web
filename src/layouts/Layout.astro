---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { hreflangMap } from '../i18n/ui';
import defaultOgImage from '../assets/studio/studio-12-hero.jpg';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  current?: string;
  image?: ImageMetadata;
  noindex?: boolean;
}
const {
  title = 'BoHeMi — Body, Health, Mind',
  description = '',
  lang = 'cs',
  current = '/',
  image = defaultOgImage,
  noindex = false,
} = Astro.props;

const isProduction = import.meta.env.PUBLIC_SITE_ENV === 'production';
const hreflang = hreflangMap[current] ?? null;
const origin = 'https://bohemi.fit';
const canonicalUrl = new URL(current, origin).toString();
const ogImageUrl = new URL(image.src, origin).toString();
const ogLocale = lang === 'en' ? 'en_US' : 'cs_CZ';

const businessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HealthClub',
  '@id': `${origin}/#business`,
  name: 'BoHeMi fitness',
  url: origin,
  image: ogImageUrl,
  logo: new URL('/apple-touch-icon.png', origin).toString(),
  telephone: '+420603989762',
  email: 'info@bohemi.fit',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Vinohradská 1438/70',
    addressLocality: 'Praha 3',
    postalCode: '130 00',
    addressCountry: 'CZ',
  },
  sameAs: [
    'https://www.facebook.com/people/Bohemi-fitness/100090517103019/',
    'https://www.instagram.com/bohemi.fit/',
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {/* Žádný <meta name="generator"> — zbytečně prozrazuje verzi Astra. */}
    {(!isProduction || noindex) && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {hreflang && <link rel="alternate" hreflang="cs" href={`${origin}${hreflang.cs}`} />}
    {hreflang && <link rel="alternate" hreflang="en" href={`${origin}${hreflang.en}`} />}
    {hreflang && <link rel="alternate" hreflang="x-default" href={`${origin}${hreflang.cs}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BoHeMi fitness" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} is:inline />

    <slot name="head" />
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <slot />
  </body>
</html>
