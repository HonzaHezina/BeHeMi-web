---
// Google recenze — výběr čtyř skutečných hodnocení z veřejného profilu
// BoHeMi fitness (výběr 12. 10. 2026, texty doslova, bez úprav kromě
// vynechaného smajlíku u Petry). Jen CZ homepage. Průměrné hodnocení a
// počet recenzí se na webu záměrně NEuvádí, dokud je Honza nepotvrdí z
// profilu — nic se nevymýšlí. Nová recenze = jen nový řádek níž; odkaz
// „Všechny recenze" míří na profil studia v Google Maps.
import Eyebrow from './Eyebrow.astro';

const GOOGLE_PROFILE = 'https://maps.app.goo.gl/z9NNTR9osXd9cxKW9';

const reviews = [
  { q: 'Chodila jsem sem na tréninky pro maminky s dětmi a absolutně bezkonkurenční. Skvělá a příjemná trenérka Klára, dostatek hraček pro děti, pohodová atmosféra a dobře vymyšlené tréninky které nebudily.', by: 'Destiny' },
  { q: 'Přístup hlavní trenérky Kláry je skvělý. Motivuje, hlídá správnou techniku, vnímá specifické potřeby každého z nás. Vybavení fitka je opravdu pestré, každý si přijde na své.', by: 'V. Michálková' },
  { q: 'Trenérka hlídá správnost provedení cviků a dokáže dobře namotivovat. Trénink s dětmi, kde děti mají k dispozici hračky a rodiče si dají do těla, je za mě super koncept.', by: 'Dominika Šťastná' },
  { q: 'Moc doporučuji, ke Klárce chodím už asi 3 roky a nemůžu si tréninky vynachválit.', by: 'Petra Tanclová' },
];
---
<section class="border-t border-border-strong">
  <div class="mx-auto max-w-[1220px] px-5 py-16 md:px-8 md:py-20">
    <Eyebrow>Recenze</Eyebrow>
    <div class="mb-9 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-[clamp(28px,3.6vw,42px)] font-extrabold tracking-[-0.03em]">Co o nás píšou lidé na Googlu</h2>
      <a href={GOOGLE_PROFILE} target="_blank" rel="noopener noreferrer" class="cursor-pointer text-base font-bold text-accent-text hover:text-ink">Všechny recenze na Googlu ↗</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {reviews.map((r) => (
        <figure class="flex flex-col justify-between rounded-2xl border border-border bg-surface p-6 md:p-7">
          <blockquote class="text-[16.5px] leading-[1.55] text-ink-warm">„{r.q}“</blockquote>
          <figcaption class="mt-4 text-[14px] font-bold text-brand">{r.by} <span class="font-normal text-ink-muted">· recenze na Googlu</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
