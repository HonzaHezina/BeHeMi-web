---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import MediaFrame from '../components/MediaFrame.astro';
import { Image } from 'astro:assets';
import { RESERVE_URL } from '../data/home';
import { photosCS } from '../data/photos';
import imgObjevovarna from '../assets/deti/objevovarna-01.jpg';
import imgObjevovarna02 from '../assets/deti/objevovarna-02.jpg';
import imgObjevovarna03 from '../assets/deti/objevovarna-03.jpg';

const objevovarnaExtra = [
  { src: imgObjevovarna02, alt: 'Objevovárna — dítě si hraje s kinetickým pískem' },
  { src: imgObjevovarna03, alt: 'Objevovárna — dítě staví z barevných kostek' },
];

// Reálná data z bohemi.fit/akademie-cirk-la-putyka/, /detska-zumba/ a /hernicka/.
// Dětská Zumba dle WP (5. 7. 2026): 6–12 let, středa 17:00, 55 min,
// pololetní kroužek 3 400 Kč — v ceníku vedená jako „/ semestr".
// Ceny ověřené proti WP 5. 7. 2026 (4 000 / 4 600 / 5 500 Kč) — drž v synku
// s cenik.astro a en/pricing.astro.
// Termín semestru potvrzen Honzou 20. 7. 2026: 16. 9. 2026 – 27. 1. 2027 je
// zimní semestr (WP popisek „letní" byl chybný/zavádějící, data platí).
// WP u kurzů ukazuje i počty míst (10/9/11) — vypadá to jako volná místa
// z bookingu, ne kapacita → na statický web nepatří (viz CLAUDE.md).
// id = stabilní kotva /krouzky-pro-deti/#<id> (ASCII, nikdy neměnit) —
// vedou na ně odkazy z HP a rozcestníku, stejná logika jako u typů lekcí.
const circusCourses = [
  {
    id: 'cirkusova-skolicka',
    t: 'Cirkusová školička',
    age: '3–5 let',
    when: 'každou středu od 14:15',
    price: '4 000 Kč / semestr',
    d: 'Zkušení trenéři a akrobaté naučí děti základní pohybové dovednosti a zdolávání jednoduchých překážek — formou hry a s pomocí cirkusových vzdělávacích technik. Rodiče jsou na hodině vítáni.',
    media: 'media-sand',
    img: 'cirkusová školička',
  },
  {
    id: 'zaklady-gymnastiky',
    t: 'Základy gymnastiky a akrobacie formou hry',
    age: '6–8 let',
    when: 'každou středu od 15:15',
    price: '4 600 Kč / semestr',
    d: 'Děti si formou hry osvojí základy gymnastiky a akrobacie. Hodina má dvě části: cvičení pro správné držení těla, koordinaci a obratnost — a jednotlivé disciplíny jako pozemní akrobacie nebo žonglování.',
    media: 'media-clay',
    img: 'základy gymnastiky a akrobacie',
  },
  {
    id: 'akrobacie-zonglovani',
    t: 'Pozemní a závěsná akrobacie, žonglování',
    age: '9–12 let',
    when: 'každou středu od 16:30',
    price: '5 500 Kč / semestr',
    d: 'Jednotlivé cirkusové disciplíny do hloubky: pozemní i závěsná akrobacie a žonglování. Ucelený soubor základních dovedností doplněný o skupinová cvičení pro spolupráci v kolektivu.',
    media: 'media-green',
    img: 'pozemní a závěsná akrobacie',
  },
];

const objevovarnaFacts = [
  'Děti do 5 let',
  'Každou středu 13:30 a 14:30 · 45 minut',
  'Max 6 dětí — rezervace nutná',
  '250 Kč / vstup',
];
---
<Layout
  title="Kroužky pro děti — BoHeMi fitness Vinohrady"
  description="Cirkusové kroužky Akademie Cirk La Putyka pro děti 3–12 let, Objevovárna pro nejmenší do 5 let a Dětská Zumba. Malé skupiny na pražských Vinohradech pod vedením zkušených lektorů a akrobatů."
>
  <Header current="/krouzky-pro-deti/" />
  <main>
    <!-- HERO -->
    <section class="relative mx-auto max-w-[1220px] overflow-hidden px-5 pb-8 pt-16 md:px-8 md:pt-20">
      <div
        class="pointer-events-none absolute right-0 top-2.5 h-[400px] w-[400px] rounded-full"
        style="background:radial-gradient(circle, rgba(226,35,26,0.12), rgba(226,35,26,0) 70%);"
        aria-hidden="true"
      ></div>
      <div class="relative">
        <p class="mb-4 text-[13px] font-extrabold uppercase tracking-[0.08em] text-accent-text">
          <a href="/lekce-a-sluzby/" class="hover:text-ink">Lekce a služby</a> · Pro děti a rodiny
        </p>
        <h1 class="text-[clamp(40px,6.2vw,76px)] font-extrabold leading-[0.98] tracking-[-0.035em]">
          Kroužky pro <span class="font-medium text-accent-text">děti</span>
        </h1>
        <p class="mt-6 max-w-[56ch] text-[clamp(18px,2.1vw,22px)] leading-[1.45] text-ink-warm">
          Cirkusové kroužky Akademie Cirk La Putyka, Objevovárna pro nejmenší a Dětská Zumba.
          Na Vinohradech, v malých skupinách, kde se dětem někdo věnuje.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <Button href={RESERVE_URL} variant="primary" external>Přihlásit dítě →</Button>
          <p class="text-[15px] text-ink-muted">Aktuální termíny a volná místa najdeš v rezervačním kalendáři.</p>
        </div>
        <nav aria-label="Rychlá navigace na kroužky" class="mt-8 flex flex-wrap gap-2.5">
          {circusCourses.map((c) => (
            <a href={`#${c.id}`} class="rounded-full border-[1.5px] border-border-button px-[18px] py-2.5 text-[14.5px] font-bold text-ink-line transition-colors hover:border-brand hover:text-brand">{c.t}</a>
          ))}
          <a href="#objevovarna" class="rounded-full border-[1.5px] border-border-button px-[18px] py-2.5 text-[14.5px] font-bold text-ink-line transition-colors hover:border-brand hover:text-brand">Objevovárna</a>
          <a href="#detska-zumba" class="rounded-full border-[1.5px] border-border-button px-[18px] py-2.5 text-[14.5px] font-bold text-ink-line transition-colors hover:border-brand hover:text-brand">Dětská Zumba</a>
        </nav>
      </div>
    </section>

    <!-- AKADEMIE CIRK LA PUTYKA -->
    <section class="mx-auto max-w-[1220px] px-5 pt-6 md:px-8">
      <h2 class="mb-3 text-[clamp(26px,3.2vw,38px)] font-extrabold leading-[1.06] tracking-[-0.03em]">Akademie Cirk La Putyka</h2>
      <p class="mb-8 max-w-[60ch] text-[17px] leading-[1.55] text-ink-soft">
        Cirkusové kroužky vedené zkušenými trenéry a akrobaty Cirk La Putyka. Děti se učí
        pohybové dovednosti, spolupráci a vytrvalost — každá věková skupina má svůj kurz.
      </p>
      <div class="space-y-6">
        {circusCourses.map((c) => (
          <article id={c.id} class="scroll-mt-24 overflow-hidden rounded-2xl border border-border bg-surface md:grid md:grid-cols-[minmax(240px,320px)_1fr]">
            <MediaFrame media={c.media} rounded="rounded-none" class="h-44 md:h-full" alt={photosCS[c.id]?.altDetail ?? photosCS[c.id]?.alt ?? `Kroužek — ${c.img}`}>
              {photosCS[c.id] && (
                <Image
                  src={photosCS[c.id].srcDetail ?? photosCS[c.id].src}
                  alt={photosCS[c.id].altDetail ?? photosCS[c.id].alt}
                  class={`h-full w-full object-cover ${photosCS[c.id].pos ?? 'object-center'}`}
                  widths={[480, 640]}
                  sizes="(min-width: 768px) 320px, 100vw"
                  loading="lazy"
                />
              )}
            </MediaFrame>
            <div class="p-7 md:p-9">
              <h3 class="text-[clamp(22px,2.6vw,28px)] font-extrabold tracking-[-0.02em]">{c.t}</h3>
              <div class="mt-2 text-[13.5px] font-bold tracking-[0.02em] text-brand">{c.age} · {c.when}</div>
              <p class="mt-4 max-w-[68ch] text-[15.5px] leading-[1.55] text-ink-soft">{c.d}</p>
              {photosCS[c.id]?.extra && (
                <div class="mt-5 flex flex-wrap gap-2.5">
                  {photosCS[c.id]!.extra!.map((photo) => (
                    <a href={photo.src.src} target="_blank" rel="noopener noreferrer" class="block h-16 w-16 cursor-pointer overflow-hidden rounded-lg border border-border transition-opacity hover:opacity-90">
                      <Image src={photo.src} alt={photo.alt} class="h-full w-full object-cover" widths={[128, 192]} sizes="64px" loading="lazy" />
                    </a>
                  ))}
                </div>
              )}
              <div class="mt-5 flex items-center justify-between gap-3">
                <span class="text-[15px] font-extrabold text-ink">{c.price}</span>
                <a href={RESERVE_URL} class="cursor-pointer text-[15px] font-bold text-accent-text hover:text-ink">Přihlásit →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-mint-border bg-mint px-7 py-6">
        <p class="max-w-[62ch] text-[16px] leading-[1.55] text-ink">
          <strong class="font-bold">Semestr běží 16. 9. 2026 – 27. 1. 2027.</strong> Plná kapacita?
          Zařadíme dítě jako náhradníka nebo rovnou na další semestr — napiš na
          <a href="mailto:info@bohemi.fit" class="font-bold text-accent-text hover:text-ink">info@bohemi.fit</a>.
        </p>
        <div class="flex shrink-0 flex-wrap gap-x-5 gap-y-1">
          <a href="https://www.laputyka.cz/cs" rel="noopener noreferrer" target="_blank" class="text-[14px] font-bold text-accent-text hover:text-ink">Více o Cirk La Putyka ↗</a>
          <a href="/fotky/" class="text-[14px] font-bold text-accent-text hover:text-ink">Fotky z lekcí →</a>
        </div>
      </div>
    </section>

    <!-- OBJEVOVÁRNA -->
    <section id="objevovarna" class="mx-auto max-w-[1220px] scroll-mt-24 px-5 pt-14 md:px-8">
      <div class="grid gap-6 overflow-hidden rounded-[22px] border border-border bg-surface lg:grid-cols-[1.1fr_0.9fr]">
        <div class="p-8 md:p-10">
          <h2 class="mb-3 text-[clamp(26px,3.2vw,38px)] font-extrabold leading-[1.06] tracking-[-0.03em]">Objevovárna</h2>
          <p class="mb-5 max-w-[54ch] text-[17px] leading-[1.55] text-ink-soft">
            Nevedená hernička pro děti do 5 let — 6 stanovišť s kreativními, smyslovými,
            motorickými i pohybovými hrami, kde děti svobodně objevují svět vlastním tempem.
            Aktivity se průběžně obměňují, oblíbené zůstávají. A je tu i místo na svačinu.
          </p>
          <ul class="mb-7 flex flex-col gap-2.5">
            {objevovarnaFacts.map((f) => (
              <li class="flex items-start gap-2.5 text-[15.5px] text-ink-line">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <Button href={RESERVE_URL} variant="brand">Rezervovat místo →</Button>
          <div class="mt-6 flex flex-wrap gap-2.5">
            {objevovarnaExtra.map((photo) => (
              <a href={photo.src.src} target="_blank" rel="noopener noreferrer" class="block h-16 w-16 cursor-pointer overflow-hidden rounded-lg border border-border transition-opacity hover:opacity-90">
                <Image src={photo.src} alt={photo.alt} class="h-full w-full object-cover" widths={[128, 192]} sizes="64px" loading="lazy" />
              </a>
            ))}
          </div>
        </div>
        <MediaFrame media="media-rose" rounded="rounded-none" class="min-h-[240px] lg:min-h-full" alt="Objevovárna — hernička pro nejmenší">
          <Image
            src={imgObjevovarna}
            alt="Objevovárna BoHeMi — dítě třídí barevné kuličky při hravé aktivitě"
            class="h-full w-full object-cover object-[50%_30%]"
            widths={[480, 640]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            loading="lazy"
          />
        </MediaFrame>
      </div>
    </section>

    <!-- DĚTSKÁ ZUMBA -->
    <section class="mx-auto max-w-[1220px] px-5 pt-14 md:px-8">
      <article id="detska-zumba" class="scroll-mt-24 overflow-hidden rounded-2xl border border-border bg-surface md:grid md:grid-cols-[minmax(240px,320px)_1fr]">
        <MediaFrame media="media-forest" rounded="rounded-none" class="h-44 md:h-full" alt="Dětská Zumba — taneční kroužek v sále BoHeMi" />
        <div class="p-7 md:p-9">
          <h2 class="text-[clamp(22px,2.6vw,28px)] font-extrabold tracking-[-0.02em]">Dětská Zumba</h2>
          <div class="mt-2 text-[13.5px] font-bold tracking-[0.02em] text-brand">6–12 let · každou středu od 17:00 · 55 minut</div>
          <p class="mt-4 max-w-[68ch] text-[15.5px] leading-[1.55] text-ink-soft">
            Pololetní taneční kroužek v rytmu Zumby — jednoduché kroky, pohybové hry
            a choreografie pro rytmus, koordinaci a sebevědomí. Bez výkonnostního tlaku,
            pro děti, které pohyb baví. Vede Eliška Velázquez.
          </p>
          <div class="mt-5 flex items-center justify-between gap-3">
            <span class="text-[15px] font-extrabold text-ink">3 400 Kč / semestr</span>
            <a href={RESERVE_URL} class="cursor-pointer text-[15px] font-bold text-accent-text hover:text-ink">Přihlásit →</a>
          </div>
        </div>
      </article>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-mint-border bg-mint px-7 py-6">
        <p class="max-w-[62ch] text-[16px] leading-[1.55] text-ink">
          <strong class="font-bold">Chceš se hýbat i ty?</strong> Skupinové lekce pro dospělé
          máme taky — přečti si, jak vypadá první návštěva.
        </p>
        <a href="/skupinove-lekce/#prvni-lekce" class="shrink-0 cursor-pointer text-[15px] font-bold text-accent-text hover:text-ink">Jdeš poprvé? →</a>
      </div>
    </section>

    <!-- FINÁLNÍ CTA -->
    <section class="mx-auto max-w-[1220px] px-5 pb-16 pt-14 md:px-8 md:pb-23">
      <div class="relative flex flex-wrap items-center justify-between gap-6 overflow-hidden rounded-[22px] bg-ink-dark p-8 text-cream md:p-[clamp(32px,5vw,56px)]">
        <div
          class="pointer-events-none absolute -bottom-22 -right-12 h-[340px] w-[340px] rounded-full"
          style="background:radial-gradient(circle, rgba(226,35,26,0.18), rgba(226,35,26,0) 70%);"
          aria-hidden="true"
        ></div>
        <div class="relative">
          <h2 class="max-w-[22ch] text-[clamp(26px,3.4vw,40px)] font-extrabold tracking-[-0.03em]">Nevíš, co pro své dítě vybrat?</h2>
          <p class="mt-3 max-w-[44ch] text-[17px] text-cream-muted">Napiš nám věk a co dítě baví — doporučíme kroužek, který mu sedne.</p>
        </div>
        <a
          href="/kontakt/"
          class="relative inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-full bg-accent-text px-7 py-3.5 text-[17px] font-bold text-cream transition-colors hover:bg-accent-deep"
        >
          Napsat nám →
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
